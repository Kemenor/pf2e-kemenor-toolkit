{
  "id": "pf2e-kemenor-toolkit",
  "title": "PF2e Kemenor Toolkit",
  "description": "A personal grab-bag of PF2e automations. Currently: summoner/eidolon linking, a genuinely shared hit point pool, Manifest/Dismiss Eidolon, and shared investiture (runes, AC, saves, Perception and skills).",
  "version": "0.2.0",
  "authors": [
    {
      "name": "Kemenor",
      "url": "https://github.com/Kemenor"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "7"
        }
      }
    ],
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "manifest": "https://github.com/ruipin/fvtt-lib-wrapper/releases/latest/download/module.json"
      }
    ],
    "conflicts": [
      {
        "id": "pf2e-eidolon-helper",
        "type": "module",
        "reason": "Both modules redirect summoner/eidolon hit point updates. Enable only one."
      }
    ]
  },
  "esmodules": [
    "scripts/module.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/Kemenor/pf2e-kemenor-toolkit",
  "manifest": "https://github.com/Kemenor/pf2e-kemenor-toolkit/releases/latest/download/module.json",
  "download": "https://github.com/Kemenor/pf2e-kemenor-toolkit/releases/latest/download/module.zip",
  "license": "MIT"
}
